    let userAddress = { ...DEFAULT_ADDRESS };

    // Quick View selection state
    let activeQVProduct = null;
    let selectedQVColor = null;
    let selectedQVSize = null;
    let selectedQVQty = 1;

    // Currency Formatter
    function formatVND(value) {
      return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
    }

    // ==========================================
    // 3. APPLICATION INITIALIZATION
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      loadStateFromStorage();
      renderCatalogGrid();
      updateAddressDisplay();
      updateCartUI();
      updateWishlistUI();
    });

    function loadStateFromStorage() {
      try {
        const savedAddr = localStorage.getItem('aura_atelier_address');
        if (savedAddr) userAddress = JSON.parse(savedAddr);

        const savedCart = localStorage.getItem('aura_atelier_cart');
        if (savedCart) cart = JSON.parse(savedCart);

        const savedWishlist = localStorage.getItem('aura_atelier_wishlist');
        if (savedWishlist) wishlist = JSON.parse(savedWishlist);
      } catch (err) {
        console.error("Lỗi đọc LocalStorage:", err);
      }
    }

    function saveCartToStorage() {
      localStorage.setItem('aura_atelier_cart', JSON.stringify(cart));
    }

    function saveWishlistToStorage() {
      localStorage.setItem('aura_atelier_wishlist', JSON.stringify(wishlist));
    }

    function saveAddressToStorage() {
      localStorage.setItem('aura_atelier_address', JSON.stringify(userAddress));
    }

    // ==========================================
    // 4. RENDERING & FILTERING LOGIC
    // ==========================================
    function renderCatalogGrid() {
      const grid = document.getElementById('product-grid');
      const emptyState = document.getElementById('empty-state');
      const countEl = document.getElementById('product-count');

      let list = productsDatabase.filter(p => {
        // Category
        if (currentCategory !== 'all' && p.category !== currentCategory) return false;
        
        // Size
        if (currentSelectedSize !== 'all') {
          if (!p.sizes.includes(currentSelectedSize) && !p.sizes.includes("Free Size")) return false;
        }

        // Price range
        if (currentPriceFilter === 'under300' && p.price >= 300000) return false;
        if (currentPriceFilter === '300to600' && (p.price < 300000 || p.price > 600000)) return false;
        if (currentPriceFilter === 'above600' && p.price <= 600000) return false;

        // Search text
        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase().trim();
          const matchName = p.name.toLowerCase().includes(q);
          const matchDesc = p.desc.toLowerCase().includes(q);
          const matchCat = p.category.toLowerCase().includes(q);
          const matchTag = p.tag.toLowerCase().includes(q);
          if (!matchName && !matchDesc && !matchCat && !matchTag) return false;
        }

        return true;
      });

      // Sorting
      if (currentSortFilter === 'price-asc') {
        list.sort((a, b) => a.price - b.price);
      } else if (currentSortFilter === 'price-desc') {
        list.sort((a, b) => b.price - a.price);
      } else if (currentSortFilter === 'rating') {
        list.sort((a, b) => b.rating - a.rating);
      } else {
        list.sort((a, b) => b.reviews - a.reviews);
      }

      countEl.textContent = list.length;

      if (list.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      grid.innerHTML = list.map(item => {
        const isFav = wishlist.includes(item.id);
        const discountPct = Math.round(((item.originalPrice - item.price) / item.originalPrice) * 100);

        return `
          <div class="bg-white rounded-2xl overflow-hidden border border-brand-200 hover:border-noir-900 shadow-2xs hover:shadow-luxury transition-all duration-300 flex flex-col group">
            
            <!-- Image Card -->
            <div class="relative aspect-3/4 overflow-hidden bg-brand-100 cursor-pointer" onclick="openQuickViewModal(${item.id})">
              <img 
                src="${item.image}" 
                alt="${item.name}" 
                loading="lazy" 
                class="w-full h-full object-cover img-zoom"
              >

              <!-- Badges -->
              <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 z-10">
                <span class="badge-shimmer bg-noir-950 text-white text-[9px] font-black uppercase px-2 py-0.5 rounded tracking-wider shadow-xs">
                  ${item.tag}
                </span>
                ${discountPct > 0 ? `
                  <span class="bg-brand-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded w-max">
                    -${discountPct}%
                  </span>
                ` : ''}
              </div>

              <!-- Wishlist Heart Button -->
              <button 
                onclick="event.stopPropagation(); toggleWishlist(${item.id}, this)"
                class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/90 backdrop-blur-md text-stone-700 hover:text-rose-500 flex items-center justify-center transition shadow-xs z-10 active:scale-90"
                title="Lưu yêu thích"
              >
                <i class="${isFav ? 'fa-solid fa-heart text-rose-500' : 'fa-regular fa-heart'} text-xs"></i>
              </button>

              <!-- Quick View CTA Hover (Desktop) -->
              <div class="absolute inset-x-3 bottom-3 hidden md:flex opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                <button 
                  onclick="event.stopPropagation(); openQuickViewModal(${item.id})"
                  class="w-full py-2 bg-white/95 backdrop-blur-md text-noir-950 font-bold text-xs rounded-xl shadow-md hover:bg-noir-950 hover:text-white transition flex items-center justify-center gap-1.5"
                >
                  <i class="fa-solid fa-eye text-[11px]"></i>
                  <span>Xem nhanh & Chọn size</span>
                </button>
              </div>
            </div>

            <!-- Content Details -->
            <div class="p-3.5 flex-1 flex flex-col justify-between space-y-2.5">
              <div>
                <div class="flex items-center justify-between text-[10px] text-stone-400 font-medium">
                  <span class="uppercase tracking-wider font-semibold text-brand-600">${item.category}</span>
                  <span class="flex items-center gap-1 text-amber-500 font-bold">
                    <i class="fa-solid fa-star text-[9px]"></i> ${item.rating}
                  </span>
                </div>

                <h3 
                  onclick="openQuickViewModal(${item.id})" 
                  class="font-display font-bold text-xs sm:text-sm text-noir-900 line-clamp-2 mt-1 leading-snug cursor-pointer hover:text-brand-600 transition"
                >
                  ${item.name}
                </h3>
              </div>

              <!-- Color dots preview -->
              <div class="flex items-center gap-1.5 pt-0.5">
                ${item.colors.map(c => `
                  <span class="w-2.5 h-2.5 rounded-full border border-stone-300" style="background-color: ${c.hex}" title="${c.name}"></span>
                `).join('')}
                <span class="text-[9px] text-stone-400 ml-1 font-medium">${item.sizes.slice(0, 3).join('/')}${item.sizes.length > 3 ? '+' : ''}</span>
              </div>

              <!-- Price & Quick Add Button -->
              <div class="flex items-end justify-between pt-1 border-t border-brand-100">
                <div>
                  <span class="text-sm sm:text-base font-black font-display text-noir-950">${formatVND(item.price)}</span>
                  <span class="block text-[10px] text-stone-400 line-through">${formatVND(item.originalPrice)}</span>
                </div>

                <button 
                  onclick="openQuickViewModal(${item.id})"
                  class="w-8 h-8 rounded-full bg-brand-100 hover:bg-noir-950 hover:text-white text-noir-900 flex items-center justify-center transition active:scale-90 cursor-pointer"
                  title="Chọn size & Thêm vào giỏ"
                >
                  <i class="fa-solid fa-plus text-xs"></i>
                </button>
              </div>

            </div>

          </div>
        `;
      }).join('');
    }

    // Filter by Category
    function filterByCategory(cat) {
      currentCategory = cat;

      // Update pill buttons
      document.querySelectorAll('.category-pill').forEach(btn => {
        if (btn.dataset.category === cat) {
          btn.className = "category-pill active px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition bg-noir-950 text-white shadow-xs";
        } else {
          btn.className = "category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200";
        }
      });

      // Update Nav link
      document.querySelectorAll('.category-nav-link').forEach(link => {
        if (link.dataset.cat === cat) {
          link.classList.add('text-brand-500', 'border-b-2', 'border-brand-500');
        } else {
          link.classList.remove('text-brand-500', 'border-b-2', 'border-brand-500');
        }
      });

      renderCatalogGrid();
    }

    // Filter by Size
    function filterBySize(size) {
      currentSelectedSize = size;
      document.querySelectorAll('.size-pill').forEach(btn => {
        if (btn.dataset.size === size) {
          btn.className = "size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-noir-950 text-white border-noir-950";
        } else {
          btn.className = "size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900";
        }
      });
      renderCatalogGrid();
    }

    // Filter by Price
    function handlePriceFilter(val) {
      currentPriceFilter = val;
      renderCatalogGrid();
    }

    // Sort Filter
    function handleSortFilter(val) {
      currentSortFilter = val;
      renderCatalogGrid();
    }

    // Live search
    function handleSearch(val) {
      searchQuery = val;
      const clearBtn = document.getElementById('search-clear-btn');
      if (val.trim() !== '') {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      renderCatalogGrid();
    }

    function clearSearch() {
      searchQuery = '';
      document.getElementById('desktop-search-input').value = '';
      const mob = document.getElementById('mobile-search-input');
      if (mob) mob.value = '';
      document.getElementById('search-clear-btn').classList.add('hidden');
      renderCatalogGrid();
    }

    function resetAllFilters() {
      currentCategory = 'all';
      currentSelectedSize = 'all';
      currentPriceFilter = 'all';
      currentSortFilter = 'featured';
      searchQuery = '';

      document.getElementById('price-range-select').value = 'all';
      document.getElementById('sort-select').value = 'featured';
      clearSearch();

      filterByCategory('all');
      filterBySize('all');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function scrollToCatalog() {
      const el = document.getElementById('catalog-section');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }

    // ==========================================
    // 5. QUICK VIEW & CONFIGURATION MODAL
    // ==========================================
    function openQuickViewModal(productId) {
      const product = productsDatabase.find(p => p.id === productId);
      if (!product) return;

      activeQVProduct = product;
      selectedQVColor = product.colors[0];
      selectedQVSize = product.sizes[0];
      selectedQVQty = 1;

      document.getElementById('qv-modal-img').src = product.image;
      document.getElementById('qv-modal-tag').textContent = product.tag;
      document.getElementById('qv-modal-category').textContent = product.category;
      document.getElementById('qv-modal-title').textContent = product.name;
      document.getElementById('qv-modal-rating').textContent = `${product.rating} (${product.reviews} đánh giá)`;
      document.getElementById('qv-modal-price').textContent = formatVND(product.price);
      document.getElementById('qv-modal-oldprice').textContent = formatVND(product.originalPrice);
      document.getElementById('qv-modal-desc').textContent = product.desc;
      document.getElementById('qv-modal-qty').textContent = '1';

      // Colors
      const colorContainer = document.getElementById('qv-modal-colors');
      colorContainer.innerHTML = product.colors.map((c, i) => `
        <button 
          type="button" 
          onclick="selectQVColor(${i})"
          class="qv-color-dot w-7 h-7 rounded-full border-2 transition ${i === 0 ? 'border-noir-950 scale-110 ring-2 ring-brand-500/30' : 'border-stone-300'}"
          style="background-color: ${c.hex};"
          title="${c.name}"
        ></button>
      `).join('');
      document.getElementById('qv-selected-color-name').textContent = selectedQVColor.name;

      // Sizes
      const sizeContainer = document.getElementById('qv-modal-sizes');
      sizeContainer.innerHTML = product.sizes.map((s, i) => `
        <button 
          type="button" 
          onclick="selectQVSize('${s}', this)"
          class="qv-size-btn py-2 text-xs font-bold rounded-xl border transition ${i === 0 ? 'bg-noir-950 text-white border-noir-950' : 'bg-white text-stone-700 border-brand-200 hover:border-noir-900'}"
        >
          ${s}
        </button>
      `).join('');

      // Open Modal
      const modal = document.getElementById('quickview-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.remove('scale-95');
      modal.querySelector('div').classList.add('scale-100');
      playAudioTone('click');
    }

    function closeQuickViewModal() {
      const modal = document.getElementById('quickview-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.add('scale-95');
      modal.querySelector('div').classList.remove('scale-100');
      document.getElementById('size-guide-popover').classList.add('hidden');
    }

    function selectQVColor(index) {
      if (!activeQVProduct) return;
      selectedQVColor = activeQVProduct.colors[index];
      document.getElementById('qv-selected-color-name').textContent = selectedQVColor.name;

      document.querySelectorAll('.qv-color-dot').forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('border-noir-950', 'scale-110', 'ring-2', 'ring-brand-500/30');
          dot.classList.remove('border-stone-300');
        } else {
          dot.classList.remove('border-noir-950', 'scale-110', 'ring-2', 'ring-brand-500/30');
          dot.classList.add('border-stone-300');
        }
      });
      playAudioTone('click');
    }

    function selectQVSize(sizeName, btn) {
      selectedQVSize = sizeName;
      document.querySelectorAll('.qv-size-btn').forEach(b => {
        b.classList.remove('bg-noir-950', 'text-white', 'border-noir-950');
        b.classList.add('bg-white', 'text-stone-700', 'border-brand-200');
      });
      btn.classList.add('bg-noir-950', 'text-white', 'border-noir-950');
      btn.classList.remove('bg-white', 'text-stone-700', 'border-brand-200');
      playAudioTone('click');
    }

    function changeQuickViewQty(delta) {
      selectedQVQty = Math.max(1, selectedQVQty + delta);
      document.getElementById('qv-modal-qty').textContent = selectedQVQty;
      playAudioTone('click');
    }

    function toggleSizeGuide() {
      document.getElementById('size-guide-popover').classList.toggle('hidden');
    }

    function addQuickViewItemToCart() {
      if (!activeQVProduct) return;

      const existingIndex = cart.findIndex(c => 
        c.id === activeQVProduct.id && 
        c.size === selectedQVSize && 
        c.color === selectedQVColor.name
      );

      if (existingIndex > -1) {
        cart[existingIndex].quantity += selectedQVQty;
      } else {
        cart.push({
          id: activeQVProduct.id,
          size: selectedQVSize,
          color: selectedQVColor.name,
          quantity: selectedQVQty
        });
      }

      saveCartToStorage();
      updateCartUI();
      closeQuickViewModal();
      playAudioTone('success');
      showToast(`Đã thêm "${activeQVProduct.name} (${selectedQVSize})" vào túi đồ!`, 'success');
      toggleCartDrawer(true);
    }

    // ==========================================
    // 6. CART MANAGEMENT & PROMO DISCOUNTS
    // ==========================================
    function changeCartItemQty(index, change) {
      if (!cart[index]) return;
      cart[index].quantity += change;
      if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
      }
      saveCartToStorage();
      updateCartUI();
      playAudioTone('click');
    }

    function removeCartItem(index) {
      cart.splice(index, 1);
      saveCartToStorage();
      updateCartUI();
      playAudioTone('click');
      showToast('Đã xóa sản phẩm khỏi túi đồ', 'info');
    }

    function updateCartUI() {
      const totalCount = cart.reduce((acc, curr) => acc + curr.quantity, 0);

      // Counters
      document.getElementById('cart-counter').textContent = totalCount;
      const mobCartCounter = document.getElementById('mobile-cart-counter');
      if (mobCartCounter) {
        mobCartCounter.textContent = totalCount;
        if (totalCount > 0) mobCartCounter.classList.remove('scale-0');
        else mobCartCounter.classList.add('scale-0');
      }
      document.getElementById('cart-drawer-count-info').textContent = `${totalCount} sản phẩm`;

      // Subtotal calculation
      let subtotal = 0;
      cart.forEach(item => {
        const p = productsDatabase.find(prod => prod.id === item.id);
        if (p) subtotal += p.price * item.quantity;
      });

      // Freeship Progress Meter for Tay Ninh
      const isTayNinhAddress = (userAddress.district || '').toLowerCase().includes('tân phú') || (userAddress.city || '').toLowerCase().includes('tây ninh');
      const freeShippingEligible = (isTayNinhAddress && subtotal >= FREESHIP_THRESHOLD_TAYNINH) || (activeVoucher && activeVoucher.freeShipping);

      const progressPct = Math.min(100, Math.round((subtotal / FREESHIP_THRESHOLD_TAYNINH) * 100));
      const remainingForFreeship = Math.max(0, FREESHIP_THRESHOLD_TAYNINH - subtotal);

      document.getElementById('freeship-progress-bar').style.width = `${progressPct}%`;
      document.getElementById('freeship-percent-badge').textContent = `${progressPct}%`;

      const statusText = document.getElementById('freeship-status-text');
      if (freeShippingEligible && subtotal > 0) {
        statusText.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-500"></i> Đơn hàng đủ điều kiện <strong>FREESHIP TÂY NINH!</strong>`;
      } else {
        statusText.innerHTML = `<i class="fa-solid fa-truck-fast text-brand-500"></i> Mua thêm <strong class="text-brand-600">${formatVND(remainingForFreeship)}</strong> để Freeship Tây Ninh`;
      }

      // Shipping & Discount
      let shippingFee = subtotal === 0 ? 0 : (freeShippingEligible ? 0 : SHIPPING_STANDARD);
      let discountAmount = 0;

      if (activeVoucher) {
        if (activeVoucher.percent) {
          discountAmount = Math.round(subtotal * (activeVoucher.percent / 100));
        } else if (activeVoucher.flat) {
          discountAmount = activeVoucher.flat;
        }
      }

      const grandTotal = Math.max(0, subtotal + shippingFee - discountAmount);

      // DOM Updates
      document.getElementById('calc-subtotal').textContent = formatVND(subtotal);
      document.getElementById('calc-shipping').textContent = shippingFee === 0 ? 'Miễn phí' : formatVND(shippingFee);
      document.getElementById('calc-grand-total').textContent = formatVND(grandTotal);

      const discountRow = document.getElementById('calc-discount-row');
      if (discountAmount > 0) {
        discountRow.classList.remove('hidden');
        document.getElementById('calc-discount-label').textContent = `Mã giảm giá (${activeVoucher.code})`;
        document.getElementById('calc-discount').textContent = `-${formatVND(discountAmount)}`;
      } else {
        discountRow.classList.add('hidden');
      }

      // Drawer Items Container
      const container = document.getElementById('cart-items-container');
      const emptyState = document.getElementById('cart-empty-state');
      const footerPanel = document.getElementById('cart-footer-panel');

      if (cart.length === 0) {
        container.classList.add('hidden');
        footerPanel.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      container.classList.remove('hidden');
      footerPanel.classList.remove('hidden');
      emptyState.classList.add('hidden');

      container.innerHTML = cart.map((item, idx) => {
        const prod = productsDatabase.find(p => p.id === item.id);
        if (!prod) return '';
        const lineTotal = prod.price * item.quantity;

        return `
          <div class="flex items-center gap-3 p-3 bg-brand-50 border border-brand-200 rounded-2xl">
            <img 
              src="${prod.image}" 
              alt="${prod.name}" 
              class="w-16 h-20 object-cover rounded-xl shrink-0 border border-brand-200"
            >
            <div class="flex-1 min-w-0">
              <h4 class="font-display font-bold text-xs text-noir-900 truncate">${prod.name}</h4>
              <p class="text-[11px] text-stone-500 mt-0.5">Màu: <strong>${item.color}</strong> • Size: <strong>${item.size}</strong></p>
              <p class="text-xs font-black text-noir-900 mt-0.5">${formatVND(prod.price)}</p>

              <div class="flex items-center gap-2 mt-2">
                <div class="flex items-center bg-white border border-brand-200 rounded-lg p-0.5">
                  <button onclick="changeCartItemQty(${idx}, -1)" class="w-6 h-6 flex items-center justify-center text-stone-600 hover:bg-brand-100 rounded text-xs cursor-pointer">
                    <i class="fa-solid fa-minus text-[9px]"></i>
                  </button>
                  <span class="w-7 text-center font-bold text-xs">${item.quantity}</span>
                  <button onclick="changeCartItemQty(${idx}, 1)" class="w-6 h-6 flex items-center justify-center text-stone-600 hover:bg-brand-100 rounded text-xs cursor-pointer">
                    <i class="fa-solid fa-plus text-[9px]"></i>
                  </button>
                </div>

                <button onclick="removeCartItem(${idx})" class="text-stone-400 hover:text-rose-500 text-xs p-1 cursor-pointer" title="Xóa">
                  <i class="fa-regular fa-trash-can"></i>
                </button>
              </div>
            </div>

            <div class="text-right">
              <span class="text-xs font-black font-display text-noir-900">${formatVND(lineTotal)}</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function toggleCartDrawer(isOpen) {
      const drawer = document.getElementById('cart-drawer');
      const panel = document.getElementById('cart-panel');

      if (isOpen) {
        drawer.classList.remove('opacity-0', 'pointer-events-none');
        panel.classList.remove('translate-x-full');
      } else {
        drawer.classList.add('opacity-0', 'pointer-events-none');
        panel.classList.add('translate-x-full');
      }
    }

    // ==========================================
    // 7. VOUCHER SYSTEM
    // ==========================================
    function applyVoucherPreset(code) {
      applyVoucherCode(code);
      toggleCartDrawer(true);
    }

    function applyCartVoucher() {
      const val = document.getElementById('cart-voucher-code').value;
      if (!val.trim()) {
        showToast('Vui lòng nhập mã giảm giá', 'error');
        return;
      }
      applyVoucherCode(val);
    }

    function applyVoucherCode(code) {
      const upper = code.trim().toUpperCase();
      const feedback = document.getElementById('voucher-feedback-msg');

      if (upper === 'AURA2026') {
        activeVoucher = { code: 'AURA2026', percent: 15, freeShipping: false };
        showToast('Áp dụng mã AURA2026 thành công: Giảm 15% tổng đơn!', 'success');
      } else if (upper === 'FREESHIP') {
        activeVoucher = { code: 'FREESHIP', percent: 0, freeShipping: true };
        showToast('Áp dụng mã FREESHIP thành công: Miễn phí giao hàng toàn quốc!', 'success');
      } else {
        showToast('Mã ưu đãi không hợp lệ hoặc đã hết lượt sử dụng', 'error');
        return;
      }

      playAudioTone('success');
      updateCartUI();

      if (feedback) {
        feedback.classList.remove('hidden');
        feedback.className = "text-[10px] font-bold text-emerald-600 block";
        feedback.textContent = `Đã áp dụng mã: ${activeVoucher.code}`;
      }
    }

    // ==========================================
    // 8. WISHLIST MANAGEMENT
    // ==========================================
    function toggleWishlist(productId, btnEl) {
      const idx = wishlist.indexOf(productId);
      if (idx > -1) {
        wishlist.splice(idx, 1);
        showToast('Đã bỏ sản phẩm khỏi mục yêu thích', 'info');
      } else {
        wishlist.push(productId);
        showToast('Đã thêm vào danh sách yêu thích!', 'success');
        if (btnEl) {
          btnEl.classList.add('animate-heart-pop');
          setTimeout(() => btnEl.classList.remove('animate-heart-pop'), 500);
        }
      }

      saveWishlistToStorage();
      updateWishlistUI();
      renderCatalogGrid();
      playAudioTone('heart');
    }

    function updateWishlistUI() {
      const count = wishlist.length;
      document.getElementById('wishlist-counter').textContent = count;
      const mobWishCounter = document.getElementById('mobile-wishlist-counter');
      if (mobWishCounter) {
        mobWishCounter.textContent = count;
        if (count > 0) mobWishCounter.classList.remove('scale-0');
        else mobWishCounter.classList.add('scale-0');
      }
      document.getElementById('wishlist-subtitle').textContent = `${count} sản phẩm đã lưu`;

      const container = document.getElementById('wishlist-items-container');
      const emptyState = document.getElementById('wishlist-empty-state');

      if (count === 0) {
        container.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      container.classList.remove('hidden');
      emptyState.classList.add('hidden');

      container.innerHTML = wishlist.map(id => {
        const prod = productsDatabase.find(p => p.id === id);
        if (!prod) return '';

        return `
          <div class="flex items-center gap-3 p-3 bg-brand-50 border border-brand-200 rounded-2xl">
            <img src="${prod.image}" alt="${prod.name}" class="w-14 h-18 object-cover rounded-xl shrink-0">
            <div class="flex-1 min-w-0">
              <h4 class="font-bold text-xs text-noir-900 truncate">${prod.name}</h4>
              <p class="text-xs font-black font-display text-noir-900 mt-0.5">${formatVND(prod.price)}</p>
              <button 
                onclick="toggleWishlistDrawer(false); openQuickViewModal(${prod.id})" 
                class="mt-2 text-[11px] font-bold text-brand-600 hover:underline flex items-center gap-1 cursor-pointer"
              >
                <span>Xem & Chọn Size</span>
                <i class="fa-solid fa-arrow-right text-[9px]"></i>
              </button>
            </div>
            <button onclick="toggleWishlist(${prod.id})" class="text-stone-400 hover:text-rose-500 p-2 cursor-pointer" title="Xóa">
              <i class="fa-solid fa-xmark text-sm"></i>
            </button>
          </div>
        `;
      }).join('');
    }

    function toggleWishlistDrawer(isOpen) {
      const drawer = document.getElementById('wishlist-drawer');
      const panel = document.getElementById('wishlist-panel');

      if (isOpen) {
        drawer.classList.remove('opacity-0', 'pointer-events-none');
        panel.classList.remove('translate-x-full');
      } else {
        drawer.classList.add('opacity-0', 'pointer-events-none');
        panel.classList.add('translate-x-full');
      }
    }

    // ==========================================
    // 9. PERSONALIZED ADDRESS IN TAN PHU, TAY NINH
    // ==========================================
    function updateAddressDisplay() {
      const fullAddr = `${userAddress.street}, ${userAddress.district}, ${userAddress.city}`;

      // Header summary
      document.getElementById('header-address-summary').textContent = fullAddr;
      document.getElementById('cart-location-preview').textContent = `${userAddress.district}, ${userAddress.city}`;
      const heroLoc = document.getElementById('hero-location-text');
      if (heroLoc) heroLoc.textContent = `${userAddress.district}, Tây Ninh`;

      // Fill in checkout preview
      document.getElementById('checkout-name-phone').textContent = `${userAddress.name} • ${userAddress.phone}`;
      document.getElementById('checkout-full-address').textContent = fullAddr;
      document.getElementById('checkout-delivery-note').textContent = userAddress.note ? `Ghi chú: ${userAddress.note}` : 'Không có ghi chú thêm';
      document.getElementById('success-order-dest').textContent = fullAddr;

      // Fill modal inputs
      document.getElementById('input-addr-name').value = userAddress.name || '';
      document.getElementById('input-addr-phone').value = userAddress.phone || '';
      document.getElementById('input-addr-district').value = userAddress.district || 'Huyện Tân Phú';
      document.getElementById('input-addr-street').value = userAddress.street || '';
      document.getElementById('input-addr-note').value = userAddress.note || '';
    }

    function openAddressModal() {
      const modal = document.getElementById('address-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.remove('scale-95');
      modal.querySelector('div').classList.add('scale-100');
    }

    function closeAddressModal() {
      const modal = document.getElementById('address-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.add('scale-95');
      modal.querySelector('div').classList.remove('scale-100');
    }

    function setQuickAddressPreset(fullStreet) {
      document.getElementById('input-addr-street').value = fullStreet;
      document.getElementById('input-addr-district').value = 'Huyện Tân Phú';
    }

    function saveAddressSettings(e) {
      e.preventDefault();
      userAddress.name = document.getElementById('input-addr-name').value.trim();
      userAddress.phone = document.getElementById('input-addr-phone').value.trim();
      userAddress.district = document.getElementById('input-addr-district').value;
      userAddress.street = document.getElementById('input-addr-street').value.trim();
      userAddress.note = document.getElementById('input-addr-note').value.trim();
      userAddress.city = "Tỉnh Tây Ninh";

      saveAddressToStorage();
      updateAddressDisplay();
      closeAddressModal();
      playAudioTone('success');
      showToast('Đã cập nhật địa chỉ giao hàng tại Tây Ninh thành công!', 'success');
      updateCartUI(); // Recheck freeship condition
    }

    // ==========================================
    // 10. CHECKOUT WORKFLOW & ORDER CELEBRATION
    // ==========================================
    function openCheckoutModal() {
      if (cart.length === 0) {
        showToast('Túi đồ của bạn đang trống!', 'error');
        return;
      }

      toggleCartDrawer(false);

      // Render checkout summary
      const itemsList = document.getElementById('checkout-items-list');
      const countEl = document.getElementById('checkout-items-count');

      let subtotal = 0;
      itemsList.innerHTML = cart.map(item => {
        const prod = productsDatabase.find(p => p.id === item.id);
        if (!prod) return '';
        const lineTotal = prod.price * item.quantity;
        subtotal += lineTotal;

        return `
          <div class="flex justify-between items-center py-2 text-xs">
            <span class="text-stone-700 truncate max-w-[270px]">${item.quantity}x ${prod.name} (${item.size}/${item.color})</span>
            <span class="font-bold text-noir-900">${formatVND(lineTotal)}</span>
          </div>
        `;
      }).join('');

      countEl.textContent = cart.reduce((a, b) => a + b.quantity, 0);

      // Calculations
      const isTayNinhAddress = (userAddress.district || '').toLowerCase().includes('tân phú') || (userAddress.city || '').toLowerCase().includes('tây ninh');
      const freeShippingEligible = (isTayNinhAddress && subtotal >= FREESHIP_THRESHOLD_TAYNINH) || (activeVoucher && activeVoucher.freeShipping);
      const shippingFee = freeShippingEligible ? 0 : SHIPPING_STANDARD;

      let discountAmount = 0;
      if (activeVoucher) {
        if (activeVoucher.percent) discountAmount = Math.round(subtotal * (activeVoucher.percent / 100));
        else if (activeVoucher.flat) discountAmount = activeVoucher.flat;
      }

      const total = Math.max(0, subtotal + shippingFee - discountAmount);

      document.getElementById('co-subtotal-text').textContent = formatVND(subtotal);
      document.getElementById('co-ship-text').textContent = shippingFee === 0 ? 'Miễn phí' : formatVND(shippingFee);
      document.getElementById('co-total-text').textContent = formatVND(total);

      const discRow = document.getElementById('co-discount-row');
      if (discountAmount > 0) {
        discRow.classList.remove('hidden');
        document.getElementById('co-discount-text').textContent = `-${formatVND(discountAmount)}`;
      } else {
        discRow.classList.add('hidden');
      }

      // Generate random order memo for QR
      const memo = "AURA" + Math.floor(1000 + Math.random() * 9000);
      document.getElementById('checkout-qr-memo').textContent = memo;

      const modal = document.getElementById('checkout-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.remove('scale-95');
      modal.querySelector('div').classList.add('scale-100');
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.add('scale-95');
      modal.querySelector('div').classList.remove('scale-100');
    }

    function togglePaymentPreview(mode) {
      const qrWrapper = document.getElementById('checkout-qr-wrapper');
      const qrTitle = document.getElementById('checkout-qr-title');
      const qrImg = document.getElementById('checkout-qr-img');

      if (mode === 'COD') {
        qrWrapper.classList.add('hidden');
      } else if (mode === 'VIETQR') {
        qrWrapper.classList.remove('hidden');
        qrTitle.textContent = "Quét VietQR Chuyển Khoản Ngân Hàng 24/7";
        qrImg.src = "https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=VIETQR_AURA_ATELIER_TAYNINH_MBBANK";
      } else if (mode === 'MOMO') {
        qrWrapper.classList.remove('hidden');
        qrTitle.textContent = "Quét Mã Ví Điện Tử MoMo Thanh Toán";
        qrImg.src = "https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=MOMO_AURA_FASHION_TAYNINH";
      }
    }

    function submitFinalOrder() {
      closeCheckoutModal();

      const orderCode = "#AURA-TN-" + Math.floor(10000 + Math.random() * 90000);
      document.getElementById('success-order-code').textContent = orderCode;
      document.getElementById('success-order-dest').textContent = `${userAddress.street}, ${userAddress.district}, ${userAddress.city}`;

      // Open celebration modal
      const modal = document.getElementById('celebration-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.remove('scale-90');
      modal.querySelector('div').classList.add('scale-100');

      playAudioTone('success');
      launchConfetti();

      // Clear cart
      cart = [];
      activeVoucher = null;
      saveCartToStorage();
      updateCartUI();
    }

    function closeCelebrationModal() {
      const modal = document.getElementById('celebration-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.querySelector('div').classList.add('scale-90');
      modal.querySelector('div').classList.remove('scale-100');
    }

    function launchConfetti() {
      try {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 120,
            spread: 80,
            origin: { y: 0.6 }
          });
          setTimeout(() => {
            confetti({
              particleCount: 60,
              angle: 60,
              spread: 60,
              origin: { x: 0.05 }
            });
            confetti({
              particleCount: 60,
              angle: 120,
              spread: 60,
              origin: { x: 0.95 }
            });
          }, 350);
        }
      } catch (err) {
        console.log("Confetti trigger:", err);
      }
    }

    // ==========================================
    // 11. TOAST NOTIFICATION SYSTEM
    // ==========================================
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-wrapper');
      const toast = document.createElement('div');

      let icon = 'fa-info-circle text-blue-500';
      let borderStyle = 'border-brand-200 bg-white/95 text-noir-900';

      if (type === 'success') {
        icon = 'fa-circle-check text-emerald-500';
        borderStyle = 'border-emerald-200 bg-emerald-50/95 text-emerald-950';
      } else if (type === 'error') {
        icon = 'fa-circle-exclamation text-rose-500';
        borderStyle = 'border-rose-200 bg-rose-50/95 text-rose-950';
      }

      toast.className = `flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-luxury border ${borderStyle} backdrop-blur-md text-xs font-bold transition-all duration-300 transform translate-y-3 opacity-0 pointer-events-auto`;
      toast.innerHTML = `
        <i class="fa-solid ${icon} text-sm shrink-0"></i>
        <span>${message}</span>
      `;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-3', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('translate-y-[-10px]', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }
  </script>

