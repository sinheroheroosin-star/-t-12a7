<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURA FASHION & ATELIER | High-Street & Contemporary Fashion</title>

  <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#faf8f5',
              100: '#f4ede4',
              200: '#e8dcce',
              300: '#d7c4b1',
              400: '#bfa38b',
              500: '#aa866d', // Warm Atelier Rose Gold / Muted Clay
              600: '#946f56',
              700: '#795843',
              800: '#644837',
              900: '#1e1a17',
              950: '#12100e',
            },
            noir: {
              800: '#1e1e24',
              900: '#121216',
              950: '#09090b',
            },
            champagne: '#c59b7d',
            emeraldAccent: '#059669',
          },
          fontFamily: {
            display: ['"Outfit"', 'sans-serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          boxShadow: {
            'luxury': '0 20px 45px -15px rgba(18, 16, 14, 0.08), 0 0 1px 1px rgba(18, 16, 14, 0.05)',
            'glow': '0 0 35px -5px rgba(170, 134, 109, 0.35)',
          }
        }
      }
    }
  </script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #faf8f5;
    }
    ::-webkit-scrollbar-thumb {
      background: #d7c4b1;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #aa866d;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Smooth Image Zoom */
    .img-zoom {
      transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .group:hover .img-zoom {
      transform: scale(1.08);
    }

    /* Badge Shimmer Effect */
    @keyframes shimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(200%); }
    }
    .badge-shimmer {
      position: relative;
      overflow: hidden;
    }
    .badge-shimmer::after {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
      animation: shimmer 2.5s infinite;
    }

    /* Heart Pop Animation */
    @keyframes heartBeat {
      0% { transform: scale(1); }
      25% { transform: scale(1.35); }
      50% { transform: scale(0.95); }
      75% { transform: scale(1.15); }
      100% { transform: scale(1); }
    }
    .animate-heart-pop {
      animation: heartBeat 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
  </style>
</head>
<body class="bg-brand-50 text-noir-900 font-sans selection:bg-brand-500 selection:text-white antialiased min-h-screen flex flex-col pb-20 md:pb-0">

  <!-- 1. TOP UTILITY & PERSONALIZED LOCATION BAR -->
  <div class="bg-noir-950 text-stone-200 text-[11px] md:text-xs py-2.5 px-4 border-b border-white/10 font-medium tracking-wide">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Pinned Delivery Address Badge -->
      <button 
        onclick="openAddressModal()" 
        class="group flex items-center gap-2 bg-white/5 hover:bg-white/10 px-3 py-1 rounded-full border border-white/10 transition text-left cursor-pointer"
        title="Nhấp để đổi địa chỉ giao hàng tại Tây Ninh"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-stone-400">Giao đến:</span>
        <span id="header-address-summary" class="font-bold text-white group-hover:text-champagne transition underline decoration-champagne/60 underline-offset-4 truncate max-w-[210px] sm:max-w-xs">
          Thị trấn Tân Phú, Huyện Tân Phú, Tỉnh Tây Ninh
        </span>
        <i class="fa-solid fa-pen text-[9px] text-stone-400 group-hover:text-white transition"></i>
      </button>

      <!-- Exclusive Perks Ribbon (Desktop) -->
      <div class="hidden lg:flex items-center gap-6 text-[11px] text-stone-300">
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-crown text-amber-400"></i>
          Đặc quyền Tây Ninh: <strong>FREESHIP đơn từ 200K</strong>
        </span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-bolt text-champagne"></i>
          Giao hỏa tốc 2 - 4h nội tỉnh
        </span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-shield-halved text-emerald-400"></i>
          Đổi size miễn phí trong 15 ngày
        </span>
      </div>

      <!-- Quick Contact & Help -->
      <div class="flex items-center gap-3">
        <a href="tel:18006886" class="hover:text-champagne transition flex items-center gap-1.5">
          <i class="fa-solid fa-headset text-[10px]"></i>
          <span class="hidden sm:inline">Hotline:</span> <strong>1800 6886</strong>
        </a>
      </div>

    </div>
  </div>

  <!-- 2. MAIN HEADER NAVIGATION -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-200/80 shadow-xs transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 gap-4">
        
        <!-- Brand Identity -->
        <a href="#" onclick="resetAllFilters(); return false;" class="flex items-center gap-3 group">
          <div class="w-11 h-11 bg-noir-950 text-white rounded-2xl flex items-center justify-center font-display font-black text-xl tracking-tighter shadow-md group-hover:bg-brand-500 transition-colors duration-300">
            A
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-display font-black text-2xl tracking-tight text-noir-950">AURA</span>
              <span class="text-[9px] tracking-widest font-bold uppercase px-1.5 py-0.5 rounded bg-brand-500 text-white">ATELIER</span>
            </div>
            <p class="text-[9px] tracking-[0.25em] uppercase text-stone-400 font-semibold">High-Street & Minimalist</p>
          </div>
        </a>

        <!-- Desktop Quick Categories Links -->
        <nav class="hidden lg:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-stone-700">
          <button onclick="filterByCategory('all')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="all">Tất cả</button>
          <button onclick="filterByCategory('Tees')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="Tees">Áo thun</button>
          <button onclick="filterByCategory('Shirts')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="Shirts">Sơ mi</button>
          <button onclick="filterByCategory('Bottoms')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="Bottoms">Quần</button>
          <button onclick="filterByCategory('Jackets')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="Jackets">Áo khoác</button>
          <button onclick="filterByCategory('Accessories')" class="hover:text-brand-500 transition relative py-2 category-nav-link" data-cat="Accessories">Phụ kiện</button>
        </nav>

        <!-- Search Bar with Live Clear -->
        <div class="flex-1 max-w-xs sm:max-w-sm relative hidden sm:block">
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xs"></i>
            <input 
              type="text" 
              id="desktop-search-input"
              oninput="handleSearch(this.value)"
              placeholder="Tìm áo sơ mi, blazer, quần ống rộng..." 
              class="w-full bg-brand-100/70 focus:bg-white text-xs pl-9 pr-8 py-2.5 rounded-full border border-transparent focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition"
            >
            <button id="search-clear-btn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-700">
              <i class="fa-solid fa-circle-xmark text-xs"></i>
            </button>
          </div>
        </div>

        <!-- Action Buttons: Wishlist & Cart -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          
          <!-- Location Pill for Mobile/Tablet -->
          <button 
            onclick="openAddressModal()" 
            class="md:hidden flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-stone-800 hover:bg-brand-200 transition"
            title="Đổi địa chỉ giao hàng"
          >
            <i class="fa-solid fa-location-dot text-brand-600 text-sm"></i>
          </button>

          <!-- Wishlist Button -->
          <button 
            onclick="toggleWishlistDrawer(true)" 
            class="relative w-10 h-10 rounded-full border border-brand-200 hover:border-noir-900 text-noir-900 flex items-center justify-center transition active:scale-90"
            title="Sản phẩm yêu thích"
          >
            <i class="fa-regular fa-heart text-sm"></i>
            <span id="wishlist-counter" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[9px] font-black w-4 h-4 rounded-full flex items-center justify-center scale-0 transition-transform">0</span>
          </button>

          <!-- Cart Drawer Button -->
          <button 
            onclick="toggleCartDrawer(true)" 
            class="relative flex items-center gap-2 bg-noir-950 hover:bg-brand-500 text-white px-4 py-2.5 rounded-full shadow-md hover:shadow-glow transition-all active:scale-95"
            title="Giỏ hàng của bạn"
          >
            <i class="fa-solid fa-bag-shopping text-sm"></i>
            <span class="text-xs font-bold hidden sm:inline">Túi đồ</span>
            <span id="cart-counter" class="bg-white text-noir-950 text-[10px] font-black px-1.5 py-0.2 rounded-full min-w-[18px] text-center shadow-xs">0</span>
          </button>

        </div>

      </div>

      <!-- Mobile Search Field -->
      <div class="pb-3 sm:hidden">
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-xs"></i>
          <input 
            type="text" 
            id="mobile-search-input"
            oninput="handleSearch(this.value)"
            placeholder="Tìm kiếm mẫu thiết kế AURA..." 
            class="w-full bg-brand-100 text-xs pl-9 pr-4 py-2.5 rounded-full border border-transparent focus:border-brand-500 outline-none"
          >
        </div>
      </div>

    </div>
  </header>

  <!-- 3. MAIN PAGE CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-10 flex-1 w-full">

    <!-- HERO EDITORIAL BANNER -->
    <section class="relative rounded-3xl overflow-hidden bg-noir-950 text-white min-h-[460px] md:min-h-[520px] flex items-center shadow-luxury">
      <!-- Background Image with Editorial Vignette -->
      <img 
        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1920&q=85" 
        alt="AURA High Fashion Collection" 
        class="absolute inset-0 w-full h-full object-cover object-center opacity-45 mix-blend-luminosity filter contrast-125"
      >
      <div class="absolute inset-0 bg-gradient-to-r from-noir-950 via-noir-950/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-noir-950/90 via-transparent to-transparent"></div>

      <!-- Hero Copy -->
      <div class="relative z-10 p-6 sm:p-12 md:p-16 max-w-2xl space-y-5">
        
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest text-champagne border border-white/15">
          <span class="w-2 h-2 rounded-full bg-champagne animate-ping"></span>
          Autumn / Winter Drop 2026
        </div>

        <h1 class="font-display font-black text-3xl sm:text-5xl md:text-6xl tracking-tight leading-[1.08] uppercase">
          Tuyên Ngôn <br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-brand-200 to-champagne">
            Gu Thời Trang
          </span> Hiện Đại
        </h1>

        <p class="text-stone-300 text-xs sm:text-sm md:text-base leading-relaxed font-normal max-w-lg">
          Những đường may tinh giản mang hơi thở đương đại, chất liệu tự nhiên tuyển chọn đứng form sang trọng. Giao tận tay bạn tại <span class="text-white font-bold underline decoration-champagne underline-offset-4" id="hero-location-text">Thị trấn Tân Phú, Tây Ninh</span> chỉ trong 2-4 giờ.
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button 
            onclick="scrollToCatalog()" 
            class="px-7 py-3.5 bg-white text-noir-950 hover:bg-brand-500 hover:text-white font-bold text-xs uppercase tracking-wider rounded-full shadow-lg transition-all duration-300 active:scale-95 flex items-center gap-2 cursor-pointer"
          >
            <span>Khám phá bộ sưu tập</span>
            <i class="fa-solid fa-arrow-down text-xs"></i>
          </button>
          
          <button 
            onclick="applyVoucherPreset('AURA2026')" 
            class="px-5 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold text-xs tracking-wider rounded-full backdrop-blur-md border border-white/20 transition flex items-center gap-2 cursor-pointer"
          >
            <i class="fa-solid fa-ticket text-champagne"></i>
            <span>Voucher độc quyền -15%</span>
          </button>
        </div>

        <!-- Micro value props -->
        <div class="pt-3 flex flex-wrap gap-4 text-[11px] text-stone-300 border-t border-white/10">
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-box-open text-champagne"></i> Đồng kiểm & thử đồ</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-arrows-rotate text-champagne"></i> Đổi size 15 ngày</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-truck-ramp-box text-champagne"></i> Gói hộp quà sang trọng</span>
        </div>

      </div>
    </section>

    <!-- PROMO BANNER: TAY NINH LOCAL PERK -->
    <div class="bg-gradient-to-r from-brand-900 via-noir-900 to-brand-950 rounded-2xl p-4 sm:p-5 text-white flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm border border-brand-500/30">
      <div class="flex items-center gap-3.5 text-center md:text-left">
        <div class="w-11 h-11 rounded-2xl bg-brand-500/20 text-champagne flex items-center justify-center text-xl shrink-0 border border-brand-500/30">
          <i class="fa-solid fa-location-dot animate-bounce"></i>
        </div>
        <div>
          <h3 class="font-display font-extrabold text-sm sm:text-base">Ưu đãi Freeship dành riêng cho Tân Phú & Tây Ninh</h3>
          <p class="text-xs text-stone-300">Đơn hàng chỉ từ <strong class="text-white">200.000đ</strong> tự động miễn phí 100% cước giao vận hỏa tốc.</p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button onclick="applyVoucherPreset('FREESHIP')" class="px-4 py-2 bg-champagne hover:bg-brand-500 text-noir-950 hover:text-white font-bold text-xs rounded-full transition shadow-xs">
          Dùng mã FREESHIP
        </button>
        <button onclick="openAddressModal()" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white font-bold text-xs rounded-full border border-white/20 transition">
          Kiểm tra địa chỉ
        </button>
      </div>
    </div>

    <!-- CATALOG & FILTER SECTION -->
    <section id="catalog-section" class="space-y-6 pt-2">
      
      <!-- Section Title & Overview -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-brand-200 pb-5">
        <div>
          <span class="text-[10px] font-black uppercase tracking-widest text-brand-600">Atelier Studio Essentials</span>
          <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-noir-950 tracking-tight mt-0.5">
            Danh Mục Thiết Kế Mới Nhất
          </h2>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
          <button onclick="filterByCategory('all')" class="category-pill active px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition bg-noir-950 text-white shadow-xs" data-category="all">
            Tất cả
          </button>
          <button onclick="filterByCategory('Tees')" class="category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200" data-category="Tees">
            Áo thun (Tees)
          </button>
          <button onclick="filterByCategory('Shirts')" class="category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200" data-category="Shirts">
            Sơ mi (Shirts)
          </button>
          <button onclick="filterByCategory('Bottoms')" class="category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200" data-category="Bottoms">
            Quần (Bottoms)
          </button>
          <button onclick="filterByCategory('Jackets')" class="category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200" data-category="Jackets">
            Áo khoác (Jackets)
          </button>
          <button onclick="filterByCategory('Accessories')" class="category-pill px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition bg-white text-stone-700 hover:bg-brand-100 border border-brand-200" data-category="Accessories">
            Phụ kiện (Accessories)
          </button>
        </div>
      </div>

      <!-- FILTER CONTROLS BAR: SIZE + PRICE + SORT -->
      <div class="bg-white p-4 rounded-2xl border border-brand-200 shadow-2xs space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-4 text-xs">
          
          <!-- Size Selector Pills -->
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-stone-400 font-bold uppercase text-[10px] tracking-wider">Kích cỡ:</span>
            <div class="flex items-center gap-1.5 flex-wrap">
              <button onclick="filterBySize('all')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-noir-950 text-white border-noir-950" data-size="all">All</button>
              <button onclick="filterBySize('XS')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="XS">XS</button>
              <button onclick="filterBySize('S')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="S">S</button>
              <button onclick="filterBySize('M')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="M">M</button>
              <button onclick="filterBySize('L')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="L">L</button>
              <button onclick="filterBySize('XL')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="XL">XL</button>
              <button onclick="filterBySize('XXL')" class="size-pill px-2.5 py-1 rounded-lg border font-bold text-xs bg-brand-50 text-stone-700 border-brand-200 hover:border-noir-900" data-size="XXL">XXL</button>
            </div>
          </div>

          <!-- Price Range & Sorting Selectors -->
          <div class="flex items-center gap-3 ml-auto flex-wrap">
            <!-- Price Range -->
            <div class="flex items-center gap-1.5">
              <span class="text-stone-400 font-medium hidden sm:inline">Mức giá:</span>
              <select 
                id="price-range-select" 
                onchange="handlePriceFilter(this.value)"
                class="bg-brand-50 border border-brand-200 text-noir-900 font-semibold px-3 py-1.5 rounded-xl outline-none focus:border-brand-500 cursor-pointer"
              >
                <option value="all">Tất cả mức giá</option>
                <option value="under300">Dưới 300.000đ</option>
                <option value="300to600">300.000đ - 600.000đ</option>
                <option value="above600">Trên 600.000đ</option>
              </select>
            </div>

            <!-- Sort dropdown -->
            <div class="flex items-center gap-1.5">
              <span class="text-stone-400 font-medium hidden sm:inline">Sắp xếp:</span>
              <select 
                id="sort-select" 
                onchange="handleSortFilter(this.value)"
                class="bg-brand-50 border border-brand-200 text-noir-900 font-semibold px-3 py-1.5 rounded-xl outline-none focus:border-brand-500 cursor-pointer"
              >
                <option value="featured">Nổi bật nhất</option>
                <option value="price-asc">Giá: Thấp đến cao</option>
                <option value="price-desc">Giá: Cao đến thấp</option>
                <option value="rating">Đánh giá cao nhất</option>
              </select>
            </div>
          </div>

        </div>

        <div class="text-[11px] text-stone-500 flex items-center justify-between border-t border-brand-100 pt-2">
          <span>Tìm thấy <strong id="product-count" class="text-noir-950 font-black">0</strong> sản phẩm tương thích</span>
